{
  "name": "nope",
  "version": "0.1.0",
  "description": "Browser extension that always rejects cookie banners and never accepts them.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": "Mamoun Mardini",
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "watch": "node scripts/build.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check-sites": "node scripts/check-sites.mjs",
    "screenshots": "node scripts/screenshots.mjs",
    "icons": "node scripts/make-icons.ts"
  },
  "devDependencies": {
    "@fontsource-variable/manrope": "^5.3.0",
    "@playwright/test": "^1.64.1",
    "@types/chrome": "^0.3.5",
    "@types/node": "^26.6.5",
    "jsdom": "^30.1.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@duckduckgo/autoconsent": "16.53.0"
  }
}
